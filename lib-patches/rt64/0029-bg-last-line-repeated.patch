+                    // one shown only ever gets a zero weight, but drawn at a higher resolution the bottom of
+                    // the frame's last line samples further down and showed the image past the frame (the
+                    // next line of the image, its top where it wraps, or whatever TMEM held when the slice
+                    // has no room for it). With the line twice it samples that same line again.
                     int16_t framePtrY1 = framePtrY0 + frameSliceH;
-                    rdp->drawTexRect(frameX0, framePtrY0 << 2, frameX1, framePtrY1 << 2, G_TX_RENDERTILE, imageS, imageT, scaleW, scaleH, false);
+                    const bool lastLineApart = (frameRemain <= 0) && (scaleBg.imageSiz != G_IM_SIZ_32b) && (2 * int32_t(tmemSliceWmax) <= tmemSize);
+                    if (lastLineApart) {
+                        const int32_t lastLineTFull = int32_t(imageT) + (((frameSliceH - 1) * int32_t(scaleH)) >> 5);
+                        const int32_t lastLineT = lastLineTFull >> 5;
