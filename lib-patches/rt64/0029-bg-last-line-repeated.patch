+                        rdp->drawTexRect(frameX0, (framePtrY1 - 1) << 2, frameX1, framePtrY1 << 2, G_TX_RENDERTILE, imageS, int16_t(lastLineTFull & 0x1F), scaleW, scaleH, false);
