+        // gSPObjRectangle: an unrotated sprite, the texture already in TMEM.
+        // The render tile is set from the sprite, then one texture rectangle
+        // is drawn at objX, objY, imageW x imageH texels scaled by 1 / scale,
+        // flipped in S or T as the sprite's flags say.
+        void doObjRectangle(State *state, const uObjSprite &sprite) {
+            RDP *rdp = state->rdp.get();
+            const uint32_t renderMode = state->rsp->objRenderMode;
+
+            // Texels (imageW and imageH are u10.5).
+            const int32_t texW = std::max<int32_t>(sprite.imageW >> 5, 1);
+            const int32_t texH = std::max<int32_t>(sprite.imageH >> 5, 1);
+            const uint8_t clamp = (renderMode & S2DEX_G_OBJRM_NOTXCLAMP) ? (G_TX_WRAP | G_TX_NOMIRROR) : (G_TX_CLAMP | G_TX_NOMIRROR);
+            rdp->setTile(G_TX_RENDERTILE, sprite.imageFmt, sprite.imageSiz, sprite.imageStride, sprite.imageAdrs, sprite.imagePal,
+                clamp, clamp, G_TX_NOMASK, G_TX_NOMASK, G_TX_NOLOD, G_TX_NOLOD);
+            rdp->setTileSize(G_TX_RENDERTILE, 0, 0, (texW - 1) << 2, (texH - 1) << 2);
+
+            // On screen (s10.2): the image's size divided by the scale (u5.10, 1.0 = 0x400).
+            const int32_t scaleW = (sprite.scaleW != 0) ? sprite.scaleW : 0x400;
+            const int32_t scaleH = (sprite.scaleH != 0) ? sprite.scaleH : 0x400;
+            const int32_t ulx = sprite.objX;
+            const int32_t uly = sprite.objY;
+            const int32_t lrx = ulx + ((int32_t(sprite.imageW) * 0x400 / scaleW) >> 3);
+            const int32_t lry = uly + ((int32_t(sprite.imageH) * 0x400 / scaleH) >> 3);
+
+            // Texture step per pixel (s5.10): 1 / scale. Starting texel (s10.5).
+            int32_t dsdx = (1 << 20) / scaleW;
+            int32_t dtdy = (1 << 20) / scaleH;
+            int32_t uls = 0;
+            int32_t ult = 0;
+            if (sprite.imageFlags & S2DEX_G_OBJ_FLAG_FLIPS) {
+                uls = (texW << 5) - 1;
+                dsdx = -dsdx;
+            }
+            if (sprite.imageFlags & S2DEX_G_OBJ_FLAG_FLIPT) {
+                ult = (texH << 5) - 1;
+                dtdy = -dtdy;
+            }
+
+            // Copy mode draws the lower right edge inclusively.
+            const bool copyMode = (rdp->otherMode.cycleType() == G_CYC_COPY);
+            const int32_t lrSubstract = copyMode ? 4 : 0;
+            if (copyMode) {
+                dsdx = 4 << 10;
+            }
+
+            state->startSpriteCommand(0);
+            rdp->drawTexRect(ulx, uly, lrx - lrSubstract, lry - lrSubstract, G_TX_RENDERTILE, int16_t(uls), int16_t(ult), int16_t(dsdx), int16_t(dtdy), false);
+            state->endSpriteCommand();
+        }
+
+        void objRectangle(State *state, DisplayList **dl) {
+            readS2DStruct(state, (*dl)->w1, sizeof(uObjSprite));
+            const uObjSprite *sprite = reinterpret_cast<const uObjSprite *>(state->rsp->S2D.struct_buffer.data());
+            doObjRectangle(state, *sprite);
+        }
+
